{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PAIA Derived Topic Semantic Profile v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile_version","topic_id","formal_catalog_version","formal_semantics_unchanged","canonical_names","domain","semantic_core","positive_intents","exclusion_cues","lexical_anchors","synthetic_utterance_patterns","contrastive_neighbors","provenance","status"],
  "properties": {
    "profile_version": {"const": "0.1.0"},
    "topic_id": {"type": "string", "minLength": 1},
    "formal_catalog_version": {"type": "string", "minLength": 1},
    "formal_semantics_unchanged": {"const": true},
    "canonical_names": {"type":"object","additionalProperties":false,"required":["zh","en"],"properties":{"zh":{"type":"string","minLength":1},"en":{"type":"string","minLength":1}}},
    "domain": {"type":"object","additionalProperties":false,"required":["id","name_zh","name_en"],"properties":{"id":{"type":"string","minLength":1},"name_zh":{"type":"string","minLength":1},"name_en":{"type":"string","minLength":1}}},
    "semantic_core": {"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "positive_intents": {"type":"array","minItems":2,"items":{"type":"string","minLength":1}},
    "exclusion_cues": {"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "lexical_anchors": {"type":"object","additionalProperties":false,"required":["zh","en","mixed"],"properties":{"zh":{"type":"array","items":{"type":"string","minLength":1}},"en":{"type":"array","items":{"type":"string","minLength":1}},"mixed":{"type":"array","items":{"type":"string","minLength":1}}}},
    "synthetic_utterance_patterns": {"type":"array","minItems":2,"items":{"type":"string","minLength":1}},
    "contrastive_neighbors": {"type":"array","items":{"type":"object","additionalProperties":false,"required":["topic_id","boundary_rule"],"properties":{"topic_id":{"type":"string","minLength":1},"boundary_rule":{"type":"string","minLength":1}}}},
    "provenance": {"type":"object","additionalProperties":false,"required":["source_classes","generator","formal_fields_overridden"],"properties":{"source_classes":{"type":"array","minItems":1,"items":{"enum":["FORMAL_CATALOG","GENERAL_SEMANTIC_REASONING","SYNTHETIC_CONTRASTIVE"]}},"generator":{"type":"string","minLength":1},"formal_fields_overridden":{"const":false}}},
    "status": {"enum":["DRAFT","VALIDATED","FROZEN"]}
  }
}
