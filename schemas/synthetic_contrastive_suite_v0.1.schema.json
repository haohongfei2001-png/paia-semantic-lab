{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PAIA SCA-02 Synthetic Contrastive Suite v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["suite_version","round","domains","case_count","cases"],
  "properties": {
    "suite_version":{"const":"0.1.0"},
    "round":{"const":"SCA-02"},
    "domains":{"type":"array","minItems":1,"items":{"type":"string","pattern":"^D[0-9]{2}$"},"uniqueItems":true},
    "case_count":{"type":"integer","minimum":1},
    "cases":{
      "type":"array",
      "minItems":1,
      "items":{
        "type":"object",
        "additionalProperties":false,
        "required":["case_id","case_type","language","text","expected_topic_id","source_topic_id","provenance"],
        "properties":{
          "case_id":{"type":"string","minLength":1},
          "case_type":{"enum":["POSITIVE","HARD_NEGATIVE"]},
          "language":{"enum":["zh","en"]},
          "text":{"type":"string","minLength":1},
          "expected_topic_id":{"type":"string","minLength":1},
          "source_topic_id":{"type":"string","minLength":1},
          "distractor_topic_id":{"type":["string","null"]},
          "edge_id":{"type":["string","null"]},
          "provenance":{
            "type":"object",
            "additionalProperties":false,
            "required":["source_classes","generator","formal_fields_overridden"],
            "properties":{
              "source_classes":{"type":"array","minItems":1,"items":{"enum":["DERIVED_SEMANTIC_PROFILE","SYNTHETIC_CONTRASTIVE"]}},
              "generator":{"const":"GPT-5.6 Sol / SCA-02"},
              "formal_fields_overridden":{"const":false}
            }
          }
        }
      }
    }
  }
}
